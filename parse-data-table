import pandas as pd
from astropy.table import Table

def load_table(path: str):
    """Load csv/fits/ecsv/tsv/parquet into a (DataFrame, units_dict)."""
    if path.endswith((".fits", ".fit")):
        t = Table.read(path)
        df = t.to_pandas()
        units = {col: str(t[col].unit) for col in t.colnames if t[col].unit}
        return df, units
    elif path.endswith(".ecsv"):
        t = Table.read(path, format="ascii.ecsv")
        df = t.to_pandas()
        units = {col: str(t[col].unit) for col in t.colnames if t[col].unit}
        return df, units
    elif path.endswith(".parquet"):
        return pd.read_parquet(path), {}
    elif path.endswith(".tsv"):
        return pd.read_csv(path, sep="\t"), {}
    else:
        return pd.read_csv(path), {}

def summarize_columns(df: pd.DataFrame, units: dict = {}) -> list[dict]:
    summary = []
    for col in df.columns:
        s = df[col]
        null_count = int(s.isna().sum())
        entry = {
            "column":     col,
            "dtype":      str(s.dtype),
            "null_count": null_count,
            "null_pct":   round(100 * null_count / len(df), 1),
            "unit":       units.get(col, ""),
        }
        if pd.api.types.is_numeric_dtype(s):
            entry["min"] = float(s.min()) if not s.isna().all() else None
            entry["max"] = float(s.max()) if not s.isna().all() else None
        else:
            entry["sample_values"] = s.dropna().unique()[:5].tolist()
        summary.append(entry)
    return summary
    
def print_summary(summary: list[dict], total_rows: int):
    print(f"Table: {total_rows} rows, {len(summary)} columns\n")
    print(f"{'Column':<40} {'dtype':<10} {'nulls%':<8} {'unit':<12} range/sample")
    print("-" * 90)
    for c in summary:
        rng = (f"{c['min']:.4g} – {c['max']:.4g}"
               if "min" in c else str(c.get("sample_values", "")))
        print(f"{c['column']:<40} {c['dtype']:<10} {c['null_pct']:<8} "
              f"{c['unit']:<12} {rng}")

import json

def save_parsed(summary: list[dict], output_path: str = "parsed_columns.json"):
    with open(output_path, "w") as f:
        json.dump(summary, f, indent=2)
    print(f"Saved → {output_path}")
