import json
import pandas as pd

with open("column_mapping.json") as f:
    mapping = json.load(f)

df = pd.read_csv("your_data_file.csv")  # adjust loader as needed

REQUIRED_FIELDS = {
    "Sources":          ["source", "ra_deg", "dec_deg"],
    "Parallaxes":       ["source", "parallax_mas"],
    "ProperMotions":    ["source", "pm_ra", "pm_dec"],
    "RadialVelocities": ["source", "rv_kms"],
    "Photometry":       ["source", "band", "magnitude"],
    "Associations":     ["source", "association"],
    "Publications":     ["reference", "bibcode"],
}

def check_nulls(df, mapping):
    issues = []
    for m in mapping:
        table = m.get("astrodb_table")
        field = m.get("astrodb_field")
        col   = m["input_column"]
        if not table or not field:
            continue
        required = REQUIRED_FIELDS.get(table, [])
        if field in required:
            null_count = int(df[col].isna().sum())
            if null_count > 0:
                issues.append({
                    "severity": "ERROR",
                    "column":   col,
                    "table":    table,
                    "field":    field,
                    "message":  f"{null_count} NULLs in required field",
                })
    return issues

  RANGE_CHECKS = {
    ("Sources",      "ra_deg"):                (0.0,   360.0),
    ("Sources",      "dec_deg"):               (-90.0,  90.0),
    ("Sources",      "epoch_year"):            (1900.0, 2100.0),
    ("Parallaxes",   "parallax_error"):        (0.0,   None),
    ("ProperMotions","pm_ra_error"):           (0.0,   None),
    ("ProperMotions","pm_dec_error"):          (0.0,   None),
    ("Associations", "membership_probability"): (0.0,   1.0),
}

def check_ranges(df, mapping):
    issues = []
    for m in mapping:
        key = (m.get("astrodb_table"), m.get("astrodb_field"))
        if key not in RANGE_CHECKS:
            continue
        lo, hi = RANGE_CHECKS[key]
        col = m["input_column"]
        s = df[col].dropna()
        if lo is not None and (s < lo).any():
            issues.append({"severity": "WARNING", "column": col,
                           "message": f"Values below expected minimum {lo}"})
        if hi is not None and (s > hi).any():
            issues.append({"severity": "WARNING", "column": col,
                           "message": f"Values above expected maximum {hi}"})
    return issues

  def check_duplicates(df, mapping):
    issues = []
    source_col = next(
        (m["input_column"] for m in mapping
         if m.get("astrodb_table") == "Sources" and m.get("astrodb_field") == "source"),
        None
    )
    if source_col:
        dupes = df[source_col].duplicated().sum()
        if dupes > 0:
            issues.append({
                "severity": "ERROR",
                "column":   source_col,
                "message":  f"{dupes} duplicate source IDs — Sources.source must be unique",
            })
    return issues


EXPECTED_TYPES = {
    "ra_deg": "float", "dec_deg": "float", "epoch_year": "float",
    "parallax_mas": "float", "parallax_error": "float",
    "pm_ra": "float", "pm_dec": "float",
    "rv_kms": "float", "rv_error": "float",
    "magnitude": "float", "magnitude_error": "float",
    "membership_probability": "float",
}

def check_types(df, mapping):
    issues = []
    for m in mapping:
        field = m.get("astrodb_field")
        if field not in EXPECTED_TYPES:
            continue
        col = m["input_column"]
        if not pd.api.types.is_numeric_dtype(df[col]):
            issues.append({
                "severity": "ERROR",
                "column":   col,
                "field":    field,
                "message":  f"Expected numeric, got {df[col].dtype}",
            })
    return issues

  def print_report(issues: list[dict]):
    errors   = [i for i in issues if i["severity"] == "ERROR"]
    warnings = [i for i in issues if i["severity"] == "WARNING"]
    print(f"\nValidation: {len(errors)} error(s), {len(warnings)} warning(s)\n")
    for i in issues:
        print(f"  [{i['severity']}] {i['column']}: {i['message']}")
    if not issues:
        print("  ✓ All checks passed.")

 def save_report(issues, output_path="validation_report.json"):
    with open(output_path, "w") as f:
        json.dump(issues, f, indent=2)
    print(f"Saved → {output_path}")     
