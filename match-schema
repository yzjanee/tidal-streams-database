import json

with open("parsed_columns.json") as f:
    parsed = json.load(f)  # list of dicts with keys: column, dtype, unit, ...

# Heuristic keyword → (table, field) lookup
HEURISTICS = {
    # Positional
    "ra":           ("Sources", "ra_deg"),
    "ra_deg":       ("Sources", "ra_deg"),
    "dec":          ("Sources", "dec_deg"),
    "dec_deg":      ("Sources", "dec_deg"),
    "epoch":        ("Sources", "epoch_year"),
    # Identifiers
    "source_id":    ("Sources", "source"),
    "gaia":         ("Names",   "other_name"),
    # Parallax
    "parallax":     ("Parallaxes", "parallax_mas"),
    "parallax_error": ("Parallaxes", "parallax_error"),
    # Proper motion
    "pmra":         ("ProperMotions", "pm_ra"),
    "pmra_error":   ("ProperMotions", "pm_ra_error"),
    "pmdec":        ("ProperMotions", "pm_dec"),
    "pmdec_error":  ("ProperMotions", "pm_dec_error"),
    # Radial velocity
    "rv":           ("RadialVelocities", "rv_kms"),
    "vel_calib":    ("RadialVelocities", "rv_kms"),
    "vrad":         ("RadialVelocities", "rv_kms"),
    # Photometry
    "phot_g":       ("Photometry", "magnitude"),
    "phot_bp":      ("Photometry", "magnitude"),
    "phot_rp":      ("Photometry", "magnitude"),
    "mag":          ("Photometry", "magnitude"),
    # Metallicity
    "feh":          ("ModeledParameters", "value"),
    # Membership
    "p_mem":        ("Associations", "membership_probability"),
    "stream":       ("Associations", "association"),
}

def auto_map(parsed: list[dict]) -> list[dict]:
    mapping = []
    for col in parsed:
        name_lower = col["column"].lower()
        matched_table, matched_field = None, None
        for keyword, (table, field) in HEURISTICS.items():
            if keyword in name_lower:
                matched_table, matched_field = table, field
                break
        mapping.append({
            "input_column": col["column"],
            "dtype":        col["dtype"],
            "unit":         col.get("unit", ""),
            "null_pct":     col.get("null_pct", 0),
            "astrodb_table": matched_table,
            "astrodb_field": matched_field,
            "confidence":   "auto" if matched_table else "unmatched",
            "notes":        "",
        })
    return mapping

def print_mapping(mapping: list[dict]):
    print(f"\n{'Input column':<42} {'→ Table':<26} {'Field':<28} Confidence")
    print("-" * 110)
    for m in mapping:
        table = m["astrodb_table"] or "—"
        field = m["astrodb_field"] or "—"
        print(f"{m['input_column']:<42} {table:<26} {field:<28} {m['confidence']}")
    unmatched = [m for m in mapping if m["confidence"] == "unmatched"]
    print(f"\n{len(unmatched)} unmatched column(s) need manual review.")

def save_mapping(mapping: list[dict], output_path: str = "column_mapping.json"):
    with open(output_path, "w") as f:
        json.dump(mapping, f, indent=2)
    print(f"Saved → {output_path}")
